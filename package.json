{
  "name": "trader",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @trader/api",
    "dev:web": "npm run dev -w @trader/web",
    "worker": "npm run dev -w @trader/worker",
    "db:migrate": "node --use-env-proxy --import tsx --env-file=.env apps/api/src/migrate.ts",
    "test": "node --use-env-proxy --import tsx --env-file=.env scripts/test.ts",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && npm run build -w @trader/web",
    "setup": "tsx scripts/setup.ts",
    "format": "prettier --write apps packages scripts tests docs README.md"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prettier": "^3.9.10",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "dependencies": {
    "decimal.js": "^10.6.0",
    "pg": "^8.16.0",
    "zod": "^4.0.0"
  }
}
