# LOCAL NON-CONTAINER DEVELOPMENT ONLY: npm run setup uses these localhost URLs.
# Coolify: use docker-compose.yaml and set only APP_ORIGIN (HTTPS) and APP_ENCRYPTION_KEY.
# Container bootstrap constructs PostgreSQL URLs using Docker DNS postgres:5432;
# DATABASE_URL / DATABASE_ADMIN_URL below are not passed to production services.
# Internal passwords and all three persistent volumes are managed by Compose.
# Optional initial Compose identifiers: POSTGRES_DB=trader, POSTGRES_USER=trader_admin, APP_DATABASE_USER=trader_app.
DATABASE_ADMIN_URL=postgres://trader:local-development-only@127.0.0.1:5432/trader
DATABASE_URL=postgres://trader_app:local-app-development-only@127.0.0.1:5432/trader
APP_ORIGIN=http://localhost:3000
PORT=3000
# Generate locally: openssl rand -hex 32
APP_ENCRYPTION_KEY=
LIVE_TRADING_PLATFORM_ENABLED=false
# Testnet execution defaults Off; enable it only in Admin Settings after Testnet acceptance checks.
# Development uses the local mail outbox. Production supports disabled email or Resend; configure integrations in Admin Settings.
MAIL_MODE=development
MAIL_FROM=
RESEND_API_KEY=
NODE_ENV=development
# Optional Phase 2: disabled until the platform owner supplies a supported model/key.
AI_PROVIDER=disabled
AI_MODEL=
AI_API_KEY=
# Shared conservative call cap across market and headline analysis, reset at UTC midnight.
AI_MAX_CALLS_PER_DAY=100
NEWS_ENABLED=false
# Optional Phase 4/5 integrations. Enter actual values securely outside Git.
# Supported AI_PROVIDER values: disabled, openai, anthropic, gemini, deepseek.
BILLING_WEBHOOK_SECRET=
TELEGRAM_BOT_TOKEN=
