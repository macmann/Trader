APP_ORIGIN=https://trader.example.com
# Generate each separately; save the encryption key permanently and back it up securely.
APP_ENCRYPTION_KEY=
# Existing shared server; dedicate one database and two pre-created roles to Trader.
# URL-encode usernames/passwords. Use sslmode=disable only on a trusted private network without TLS.
DATABASE_URL=postgresql://trader_app:ENCODED_PASSWORD@postgres.example.internal:5432/trader?sslmode=verify-full
DATABASE_ADMIN_URL=postgresql://trader_migrator:ENCODED_PASSWORD@postgres.example.internal:5432/trader?sslmode=verify-full
# Must match the username in DATABASE_URL; used for migration grants.
APP_DATABASE_USER=trader_app
# Verify your sending domain with Resend first.
MAIL_FROM=Trader <accounts@example.com>
RESEND_API_KEY=
AI_PROVIDER=disabled
AI_MODEL=
AI_API_KEY=
AI_MAX_CALLS_PER_DAY=100
NEWS_ENABLED=false
TELEGRAM_BOT_TOKEN=
BILLING_WEBHOOK_SECRET=
