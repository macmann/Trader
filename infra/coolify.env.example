APP_ORIGIN=https://trader.example.com
# Generate each separately; save the encryption key permanently and back it up securely.
APP_ENCRYPTION_KEY=
# Existing shared server; dedicate one database and two pre-created roles to Trader.
PGHOST=postgres.example.internal
PGPORT=5432
PGDATABASE=trader
# Use disable only on a trusted private network if the server has no TLS.
PGSSLMODE=verify-full
APP_DATABASE_USER=trader_app
APP_DATABASE_PASSWORD=
MIGRATION_DATABASE_USER=trader_migrator
MIGRATION_DATABASE_PASSWORD=
# Verify your sending domain with Resend first.
MAIL_FROM=Trader <accounts@example.com>
RESEND_API_KEY=
AI_PROVIDER=disabled
AI_MODEL=
AI_API_KEY=
AI_MAX_CALLS_PER_DAY=100
NEWS_ENABLED=false
TELEGRAM_BOT_TOKEN=
BILLING_WEBHOOK_SECRET=
